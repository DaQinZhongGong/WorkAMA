page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #1f2937;
  background-color: #f8fafc;
}

.container {
  padding: 32rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.primary-btn {
  background: #2563eb;
  color: #fff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  text-align: center;
  margin-top: 24rpx;
}

.primary-btn[disabled] {
  background: #93c5fd;
}

.ghost-btn {
  background: transparent;
  color: #2563eb;
  border: 1rpx solid #2563eb;
  border-radius: 12rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  text-align: center;
  margin-top: 16rpx;
}

.input {
  background: #f1f5f9;
  border-radius: 12rpx;
  height: 80rpx;
  padding: 0 24rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 24rpx;
}

.error {
  color: #dc2626;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 32rpx;
  color: #94a3b8;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
}

.message {
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  max-width: 80%;
}

.message.user {
  background: #dbeafe;
  align-self: flex-end;
  margin-left: auto;
}

.message.assistant {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  align-self: flex-start;
}
