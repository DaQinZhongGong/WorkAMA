.profile-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  background: #dbeafe;
  color: #2563eb;
  font-size: 36rpx;
  font-weight: 600;
  margin-right: 24rpx;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.email {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.menu-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  border-bottom: 1rpx solid #f1f5f9;
  font-size: 30rpx;
  color: #1f2937;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #94a3b8;
  font-size: 32rpx;
}
