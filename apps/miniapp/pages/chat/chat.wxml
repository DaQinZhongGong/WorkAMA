<view class="chat-page">
  <view class="message-list" scroll-y>
    <block wx:if="{{messages.length === 0}}">
      <view class="empty">暂无消息，开始对话吧</view>
    </block>
    <block wx:for="{{messages}}" wx:key="id">
      <view class="message {{item.role}}">
        <text>{{item.content}}</text>
      </view>
    </block>
  </view>

  <view class="input-bar">
    <input class="chat-input" type="text" placeholder="输入消息..." value="{{inputValue}}" bindinput="onInput" />
    <view class="send-btn {{inputValue ? 'active' : ''}}" bindtap="sendMessage">发送</view>
  </view>
</view>
