{
  "manifest_version": 3,
  "name": "WorkAMA Context",
  "version": "0.1.0",
  "description": "Capture a user-selected page excerpt and hand it to WorkAMA.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "clipboardWrite"],
  "action": {
    "default_title": "Open WorkAMA Context",
    "default_popup": "src/popup.html"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "src/sidepanel.html" },
  "options_ui": { "page": "src/options.html", "open_in_tab": true },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
