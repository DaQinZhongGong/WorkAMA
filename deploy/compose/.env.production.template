# WorkAMA 生产环境变量模板
#
# 用法：复制为 deploy/compose/.env.production 并逐项填入真值（经 secret manager
# 注入，禁止入仓）；然后 `make prod-check` 预检，`make prod-up` 拉起。
# 缺失任何 REQUIRED 项时 compose 解析期即失败（docker-compose.prod.yml 的 :? 插值）。
#
# 可运维配置（限流/SMTP/OAuth/LLM 渠道/特性开关等）不在此文件——
# 部署后经控制台 /admin/platform-config 可视化管理，UI 值优先级最高、实时生效。

# ---------- REQUIRED：安全密钥（无默认回退，缺失即拒绝启动） ----------
# 服务间内部令牌（X-Internal-Token），>=16 字符随机值，全栈一致
INTERNAL_TOKEN=
# JWT 签名密钥，>=32 字符随机值（未配置 RSA 密钥对时使用 HS256）
JWT_SECRET=
# 口令/API-key 哈希胡椒，>=16 字符随机值；与历史数据绑定，一经设定不可更换
KEY_PEPPER=
# 字段级加密主密钥：Fernet key（32 字节 url-safe base64）。生成：
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ---------- REQUIRED：基础设施 ----------
POSTGRES_DB=workama
POSTGRES_USER=workama
POSTGRES_PASSWORD=
MINIO_ROOT_USER=workama
MINIO_ROOT_PASSWORD=

# ---------- 推荐显式声明（缺省走代码默认/容器名解析） ----------
WORKAMA_ENV=production
# 对外端口（默认即下列值；如需修改请保持 20200-20299 端口策略）
PLATFORM_API_PORT=20200
AGENT_PORT=20201
GATEWAY_PORT=20202
SANDBOX_FLEET_PORT=20203
WEB_PORT=20204
MINIAPP_PORT=20205
POSTGRES_PORT=20210
REDIS_PORT=20211
NATS_PORT=20212
# CORS 受信前端来源（逗号分隔；也可部署后在控制台修改 cors_origins）
CORS_ORIGINS=https://console.example.com

# ---------- 明确不在此管理的配置 ----------
# LLM 渠道 / staging 覆盖渠道 / SMTP / OAuth / 限流 / 连接池 / 特性开关
# → 全部经 /admin/platform-config 配置中心管理。
