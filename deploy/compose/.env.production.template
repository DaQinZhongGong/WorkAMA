# ============================================================================
# WorkAMA Docker Compose - Production environment template
# ============================================================================
#
# 用途：作为生产部署的 .env 模板，复制为 .env.production 后填入真实值。
#   cp .env.production.template .env.production
#   vi .env.production
#
# 重要：所有 CHANGE_ME_* / REPLACE_ME_* / __FILL_ME__ 占位符必须替换为真实
# 强随机值后再启动。生成强随机值：
#   openssl rand -hex 32                                    # JWT_SECRET / INTERNAL_TOKEN / KEY_PEPPER
#   openssl rand -base64 32 | tr -d '\n'; echo             # ENCRYPTION_KEY
#   openssl rand -base64 24 | tr -d '/+=' | head -c 24; echo # POSTGRES_PASSWORD / MINIO_ROOT_PASSWORD
#
# 字段标记：[必填] 不填无法启动；[可选] 留空时使用默认值或关闭功能；[敏感] 必须保密。
# ============================================================================

# ----------------------------------------------------------------------------
# 运行环境
# ----------------------------------------------------------------------------
# [必填] 部署环境标识，生产必须为 production。
WORKAMA_ENV=production
# [可选] 应用日志级别（debug / info / warning / error），生产推荐 info。
LOG_LEVEL=info
# [可选] OpenTelemetry 开关。
OTEL_ENABLED=true

# ----------------------------------------------------------------------------
# PostgreSQL [敏感]
# ----------------------------------------------------------------------------
# [必填][敏感] Postgres 数据库名。
POSTGRES_DB=workama
# [必填][敏感] Postgres 业务用户名。
POSTGRES_USER=workama
# [必填][敏感] Postgres 业务用户密码，必须为强随机。
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
# [可选] 宿主机暴露端口（生产建议改为 127.0.0.1:55432 或不暴露）。
POSTGRES_PORT=55432

# ----------------------------------------------------------------------------
# Redis [敏感]
# ----------------------------------------------------------------------------
# [可选] Redis 宿主机暴露端口（生产建议不暴露，仅内部访问）。
REDIS_PORT=56379
# [可选] Redis 密码（当前 Compose 中 Redis 未启用 AUTH；如需启用请修改 docker-compose.yml）。
# REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ----------------------------------------------------------------------------
# NATS
# ----------------------------------------------------------------------------
# [可选] NATS 客户端端口。
NATS_PORT=54222
# [可选] NATS 监控端口。
NATS_MONITOR_PORT=58222

# ----------------------------------------------------------------------------
# MinIO [敏感]
# ----------------------------------------------------------------------------
# [必填][敏感] MinIO 管理员用户名。
MINIO_ROOT_USER=workama
# [必填][敏感] MinIO 管理员密码，必须为强随机（≥ 8 字符）。
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
# [可选] MinIO API 宿主机端口。
MINIO_PORT=9010
# [可选] MinIO Console 宿主机端口。
MINIO_CONSOLE_PORT=9011

# ----------------------------------------------------------------------------
# JWT / 鉴权 [敏感]
# ----------------------------------------------------------------------------
# [必填][敏感] JWT HS256 签名密钥（≥ 32 字节）。
JWT_SECRET=CHANGE_ME_TO_STRONG_RANDOM_32_BYTES
# [可选][敏感] JWT RS256 私钥（PEM 格式，多行用 \n 转义）。留空时使用 HS256。
JWT_PRIVATE_KEY=
# [可选][敏感] JWT RS256 公钥（PEM 格式，与 JWT_PRIVATE_KEY 配对）。
JWT_PUBLIC_KEY=
# [必填][敏感] 服务间调用 Bearer 令牌（platform-api / gateway / agent-server / sandbox-fleet 共享）。
INTERNAL_TOKEN=CHANGE_ME_TO_STRONG_RANDOM_32_BYTES
# [必填][敏感] 密码哈希额外盐（影响所有用户密码哈希，部署后不可更改）。
KEY_PEPPER=CHANGE_ME_TO_STRONG_RANDOM_32_BYTES
# [必填][敏感] 32 字节字段级加密密钥（Base64），用于加密敏感字段。
ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTES
# [可选] 调试令牌（生产必须 false）。
AUTH_DEBUG_TOKENS=false
# [可选] 是否启用 OAuth 登录。
AUTH_OAUTH_ENABLED=false
# [可选] OAuth 回调基础 URL（生产应为 https://your-domain）。
OAUTH_REDIRECT_BASE_URL=https://workama.example.com
# [可选] 一次性 setup token，用于首次创建管理员；创建完成后置空。
SETUP_TOKEN=

# ----------------------------------------------------------------------------
# Passkey / WebAuthn
# ----------------------------------------------------------------------------
# [必填] Passkey RP ID（生产为正式域名，如 workama.example.com）。
WORKAMA_PASSKEY_RP_ID=workama.example.com
# [必填] Passkey Origin（前端 URL，如 https://workama.example.com）。
WORKAMA_PASSKEY_ORIGIN=https://workama.example.com
# [可选] Passkey RP 显示名称。
WORKAMA_PASSKEY_RP_NAME=WorkAMA
# [可选] Passkey 超时（毫秒）。
WORKAMA_PASSKEY_TIMEOUT_MS=60000

# ----------------------------------------------------------------------------
# CORS / SMTP
# ----------------------------------------------------------------------------
# [必填] 允许的前端来源（逗号分隔多个）。
CORS_ORIGINS=https://workama.example.com
# [可选] SMTP 服务器地址（用于邮件通知 / 邀请 / 密码重置）。
SMTP_HOST=
# [可选] SMTP 端口。
SMTP_PORT=25
# [可选] 发件人地址。
SMTP_FROM=notifications@workama.example.com

# ----------------------------------------------------------------------------
# OAuth 提供商 [敏感]
# ----------------------------------------------------------------------------
# [可选][敏感] GitHub OAuth App。
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_AUTHORIZATION_URL=https://github.com/login/oauth/authorize
# [可选][敏感] Google OAuth App。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth

# ----------------------------------------------------------------------------
# MCP 工具
# ----------------------------------------------------------------------------
# [可选] 是否启用 stdio MCP 工具执行（生产建议关闭）。
WORKAMA_MCP_STDIO_ENABLED=false
# [可选] stdio 允许的命令白名单。
WORKAMA_MCP_STDIO_ALLOWED_COMMANDS=
# [可选] MCP 传输超时（秒）。
WORKAMA_MCP_TRANSPORT_TIMEOUT_SECONDS=30

# ----------------------------------------------------------------------------
# Gateway [敏感]
# ----------------------------------------------------------------------------
# [可选] 宿主机端口。
GATEWAY_PORT=8080
# [可选] 是否启用 Go 网关直连管道（生产建议 true）。
GATEWAY_GO_CHAT_COMPLETIONS_ENABLED=true
# [可选] 响应存储 TTL。
WORKAMA_RESPONSES_TTL=24h
# [可选][敏感] 真实 LLM 渠道（openai / anthropic / azure）。留空时使用 mock。
LLM_STAGING_PROVIDER=
# [可选][敏感] LLM API Key。
LLM_STAGING_API_KEY=
# [可选][敏感] LLM 网关 base URL。
LLM_STAGING_BASE_URL=
# [可选][敏感] 默认模型名。
LLM_STAGING_MODEL=

# ----------------------------------------------------------------------------
# Moderation 模型 [敏感]
# ----------------------------------------------------------------------------
# [可选] 是否启用 moderation 模型。
WORKAMA_MODERATION_MODEL_ENABLED=false
# [可选] 提供商（none / openai / azure / custom）。
WORKAMA_MODERATION_MODEL_PROVIDER=none
# [可选] 模型端点。
WORKAMA_MODERATION_MODEL_ENDPOINT=
# [可选][敏感] API Key。
WORKAMA_MODERATION_MODEL_API_KEY=
# [可选] 模型名。
WORKAMA_MODERATION_MODEL_MODEL=workama-moderation
# [可选] 模型版本。
WORKAMA_MODERATION_MODEL_VERSION=unconfigured
# [可选] 允许的 host 白名单。
WORKAMA_MODERATION_MODEL_ALLOWED_HOSTS=

# ----------------------------------------------------------------------------
# Platform API / Agent Server / Sandbox Fleet 端口
# ----------------------------------------------------------------------------
PLATFORM_API_PORT=8000
AGENT_PORT=8001
SANDBOX_FLEET_PORT=8002

# ----------------------------------------------------------------------------
# Sandbox Fleet [敏感]
# ----------------------------------------------------------------------------
# [必填] 沙箱 provider（docker / firecracker）。生产建议 docker + runsc。
SANDBOX_PROVIDER=docker
# [必填] 沙箱运行时（runc / runsc / kata-fc）。生产建议 runsc。
SANDBOX_RUNTIME=runsc
# [可选] Firecracker 运行时名（kata-fc 时使用）。
SANDBOX_FIRECRACKER_RUNTIME=kata-fc
# [可选] Firecracker 二进制路径。
SANDBOX_FIRECRACKER_BINARY=/usr/local/bin/firecracker
# [可选] Firecracker 内核镜像路径。
SANDBOX_FIRECRACKER_KERNEL_IMAGE=
# [可选] Firecracker rootfs 镜像路径。
SANDBOX_FIRECRACKER_ROOTFS_IMAGE=
# [可选] Firecracker socket 目录。
SANDBOX_FIRECRACKER_SOCKET_DIR=/run/workama/firecracker
# [可选] KVM 设备路径。
SANDBOX_FIRECRACKER_KVM_PATH=/dev/kvm
# [可选] 是否强制 gVisor（生产建议 true，需先注册 runsc runtime）。
SANDBOX_REQUIRE_GVISOR=false
# [必填] 是否强制 microVM 隔离（生产必须 true；false 时 fail-closed 503 不放行）。
SANDBOX_REQUIRE_MICROVM=false
# [可选] 沙箱空闲回收秒数。
SANDBOX_IDLE_SECONDS=900
# [可选] 沙箱最大存活秒数。
SANDBOX_TTL_SECONDS=86400
# [可选] 预热沙箱数量。
SANDBOX_PREWARM_SIZE=2
# [可选] 全局最大沙箱总数。
SANDBOX_MAX_TOTAL=50
# [可选] 每工作区最大沙箱数。
SANDBOX_MAX_PER_WORKSPACE=20

# ----------------------------------------------------------------------------
# Web 前端
# ----------------------------------------------------------------------------
# [可选] Web 宿主机端口。
WEB_PORT=3000
# [必填] 前端构建时注入的 API URL（生产为 https://your-domain/api）。
VITE_PLATFORM_API_URL=https://workama.example.com/api
# [必填] 前端构建时注入的 WebSocket URL（生产为 wss://your-domain/ws）。
VITE_AGENT_WS_URL=wss://workama.example.com/ws
# [可选] 前端嵌入的 Grafana 看板 URL。
VITE_GRAFANA_URL=https://workama.example.com/grafana/d/workama-overview/workama-platform-overview?orgId=1&kiosk=1

# ----------------------------------------------------------------------------
# Miniapp
# ----------------------------------------------------------------------------
# [可选] Miniapp 宿主机端口。
MINIAPP_PORT=3200

# ----------------------------------------------------------------------------
# 监控 [敏感]
# ----------------------------------------------------------------------------
# [可选] Prometheus 宿主机端口。
PROMETHEUS_PORT=19090
# [可选] Grafana 宿主机端口。
GRAFANA_PORT=13000
# [必填][敏感] Grafana 管理员用户名。
GRAFANA_ADMIN_USER=admin
# [必填][敏感] Grafana 管理员密码，必须为强随机。
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ----------------------------------------------------------------------------
# 烟测账号（仅用于自动化测试，生产部署可清空）
# ----------------------------------------------------------------------------
# [可选][敏感] 烟测账号邮箱。
TEST_ACCOUNT_EMAIL=
# [可选][敏感] 烟测账号密码。
TEST_ACCOUNT_PASSWORD=
