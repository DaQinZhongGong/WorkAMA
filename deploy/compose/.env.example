# WorkAMA Docker Compose Configuration
# ============================================
# All host-side ports use the 20200-20299 range.

# --- Core Application Services (20200-20209) ---
PLATFORM_API_PORT=20200
AGENT_PORT=20201
GATEWAY_PORT=20202
SANDBOX_FLEET_PORT=20203
WEB_PORT=20204
MINIAPP_PORT=20205

# --- Infrastructure Services (20210-20219) ---
POSTGRES_PORT=20210
REDIS_PORT=20211
NATS_PORT=20212
NATS_MONITOR_PORT=20213

# --- Storage & Monitoring (20220-20239) ---
MINIO_PORT=20220
MINIO_CONSOLE_PORT=20221
GRAFANA_PORT=20230
PROMETHEUS_PORT=20231

# --- Observability (20240-20249) ---
OTEL_GRPC_PORT=20240
OTEL_HTTP_PORT=20241
OTEL_METRICS_PORT=20242
OTEL_HEALTH_PORT=20243

# --- Build-time VITE Variables ---
VITE_PLATFORM_API_URL=http://localhost:20200
VITE_AGENT_WS_URL=ws://localhost:20201
VITE_GRAFANA_URL=http://localhost:20230/d/workama-overview/workama-platform-overview?orgId=1&kiosk=1

# --- Database Credentials ---
POSTGRES_DB=workama
POSTGRES_USER=workama
POSTGRES_PASSWORD=workama_dev

# --- MinIO Credentials ---
MINIO_ROOT_USER=workama
MINIO_ROOT_PASSWORD=workama_minio

# --- Grafana Credentials ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=workama_grafana

# --- Security ---
JWT_SECRET=workama-dev-jwt-secret-2026
INTERNAL_TOKEN=workama-dev-internal-token-2026
KEY_PEPPER=workama-dev-key-pepper-2026
ENCRYPTION_KEY=QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=

# --- Auth ---
AUTH_DEBUG_TOKENS=true
AUTH_OAUTH_ENABLED=false
OAUTH_REDIRECT_BASE_URL=http://localhost:20200

# --- Passkey ---
WORKAMA_PASSKEY_RP_ID=localhost
WORKAMA_PASSKEY_ORIGIN=http://localhost:20204
WORKAMA_PASSKEY_RP_NAME=WorkAMA

# --- CORS ---
CORS_ORIGINS=http://localhost:20204,http://localhost:20205,http://localhost:3000,http://web:3000,http://miniapp:80

# --- Gateway ---
GATEWAY_GO_CHAT_COMPLETIONS_ENABLED=true
WORKAMA_ENV=development

# --- MCP ---
WORKAMA_MCP_STDIO_ENABLED=false

# --- Moderation ---
WORKAMA_MODERATION_MODEL_ENABLED=false
