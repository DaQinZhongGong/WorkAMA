{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workama.dev/schemas/community-provenance.v1.json",
  "title": "WorkAMA local community provenance",
  "type": "object",
  "required": [
    "schema_version",
    "predicate_type",
    "build_type",
    "builder",
    "subject",
    "invocation",
    "local_only",
    "signed",
    "signature_status",
    "production_attestation"
  ],
  "properties": {
    "schema_version": { "const": "workama.community.provenance.v1" },
    "predicate_type": { "const": "https://slsa.dev/provenance/v1" },
    "build_type": { "const": "https://workama.dev/community/source-package" },
    "builder": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string" },
          "digest": {
            "type": "object",
            "required": ["sha256"],
            "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
          }
        }
      }
    },
    "invocation": { "type": "object" },
    "local_only": { "const": true },
    "signed": { "const": false },
    "signature_status": { "const": "not-signed" },
    "production_attestation": { "const": false }
  },
  "additionalProperties": true
}
